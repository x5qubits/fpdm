  "license": "MIT",
  "authors": [
    {
      "name": "Olivier Plathey",
      "email": "oliver@fpdf.org",
      "homepage": "http://www.fpdf.org/",
      "role": "Original Author"
    },
    {
      "name": "codeshell",
      "role": "Previous Maintainer",
      "homepage": "https://github.com/codeshell/"
    },
    {
      "name": "Five Quantum Bits",
      "homepage": "https://fiveqb.com",
      "role": "Maintainer"
    }
  ],
  "homepage": "https://github.com/fiveqb/fpdm-fqb",
  "autoload": {
    "classmap": [
      "src/fpdm.php",
      "src/filters/"
